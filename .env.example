# PostgreSQL (used by backend and DB admin)
POSTGRES_USER=dmp
POSTGRES_PASSWORD=dmp_secret
POSTGRES_DB=dmp

# Connection string for backend (must match Postgres credentials above)
DATABASE_URL=postgresql://dmp:dmp_secret@postgres:5432/dmp

# MinIO (S3-compatible); same credentials for API and Console
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Backend: S3 config (when running in Docker, use service name 'minio')
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_UPLOADS=bulk-uploads
S3_BUCKET_EXPORTS=exports

# Frontend: API base URL (when running in browser against Docker backend)
# VITE_ or NG_ env vars depend on Angular config; set in frontend when added
# API_URL=http://localhost:8000
